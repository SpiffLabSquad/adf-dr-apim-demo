<!--
  REFERENCE COPY of the APIM operation policy for:  POST /adf/trigger/{pipelineName}

  The live policy is deployed by infra/modules/apim.bicep, which substitutes these
  tokens at deploy time:
      __SUB__     -> subscription id
      __RG__      -> resource group name
      __FACTORY__ -> target Data Factory name (region-local)
      __REGION__  -> region label, surfaced back in the X-Served-Region header

  How it works:
    1. send-request builds the ADF "createRun" control-plane URL for the matched pipeline.
    2. authentication-managed-identity attaches an ARM bearer token for APIM's
       system-assigned identity (which holds "Data Factory Contributor" on the factory),
       so the caller never handles Azure credentials.
    3. return-response relays ADF's status + body and stamps X-Served-Region /
       X-Served-Factory so you can see which region handled the call.
-->
<policies>
  <inbound>
    <base />
    <send-request mode="new" response-variable-name="adfResponse" timeout="30" ignore-error="false">
      <set-url>@("https://management.azure.com/subscriptions/__SUB__/resourceGroups/__RG__/providers/Microsoft.DataFactory/factories/__FACTORY__/pipelines/" + context.Request.MatchedParameters["pipelineName"] + "/createRun?api-version=2018-06-01")</set-url>
      <set-method>POST</set-method>
      <set-header name="Content-Type" exists-action="override">
        <value>application/json</value>
      </set-header>
      <set-body>{}</set-body>
      <authentication-managed-identity resource="https://management.azure.com/" />
    </send-request>
    <return-response>
      <set-status code="@(((IResponse)context.Variables["adfResponse"]).StatusCode)" reason="@(((IResponse)context.Variables["adfResponse"]).StatusReason)" />
      <set-header name="Content-Type" exists-action="override">
        <value>application/json</value>
      </set-header>
      <set-header name="X-Served-Region" exists-action="override">
        <value>__REGION__</value>
      </set-header>
      <set-header name="X-Served-Factory" exists-action="override">
        <value>__FACTORY__</value>
      </set-header>
      <set-body>@(((IResponse)context.Variables["adfResponse"]).Body.As<string>())</set-body>
    </return-response>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
