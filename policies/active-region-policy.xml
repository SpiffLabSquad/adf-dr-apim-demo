<!--
  REFERENCE COPY (rendered for readability) of the APIM operation policy for:
      POST /adf/trigger/{pipelineName}

  The live policy is deployed by infra/modules/apim.bicep, which:
    * substitutes __SUB__, __RG__, __PRIFACTORY__, __SECFACTORY__ at deploy time, and
    * XML-escapes operators inside attributes/expressions
        <   -> &lt;      "   -> &quot;
  This copy leaves them un-escaped so the logic is easy to read.

  Behaviour: trigger ONLY the ADF region that is currently active (the {{active-region}}
  named value) and relay that factory's real response. Failover is flag-driven — there is
  no automatic cross-region retry (createRun is not idempotent, so a silent retry could
  start the pipeline twice). The calling app always uses the same URL.
-->
<policies>
  <inbound>
    <base />
    <!-- Route to whichever ADF region is currently active. -->
    <set-variable name="preferred" value="{{active-region}}" />
    <choose>
      <when condition="@((string)context.Variables["preferred"] == "primary")">
        <set-variable name="factory" value="<PRIMARY_FACTORY>" />
        <set-variable name="servedRegion" value="primary" />
      </when>
      <when condition="@((string)context.Variables["preferred"] == "secondary")">
        <set-variable name="factory" value="<SECONDARY_FACTORY>" />
        <set-variable name="servedRegion" value="secondary" />
      </when>
      <otherwise>
        <!-- Fail loudly on an unexpected flag rather than silently defaulting to a region. -->
        <return-response>
          <set-status code="503" reason="Service Unavailable" />
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-body>{ "error": "invalid active-region named value; expected 'primary' or 'secondary'" }</set-body>
        </return-response>
      </otherwise>
    </choose>

    <!-- Trigger createRun on the active region's factory (managed-identity auth). -->
    <send-request mode="new" response-variable-name="adfResponse" timeout="30" ignore-error="false">
      <set-url>@("https://management.azure.com/subscriptions/<SUB>/resourceGroups/<RG>/providers/Microsoft.DataFactory/factories/" + (string)context.Variables["factory"] + "/pipelines/" + System.Uri.EscapeDataString((string)context.Request.MatchedParameters["pipelineName"]) + "/createRun?api-version=2018-06-01")</set-url>
      <set-method>POST</set-method>
      <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
      <set-body>{}</set-body>
      <authentication-managed-identity resource="https://management.azure.com/" />
    </send-request>

    <!-- Relay the factory's real status and body, tagged with the region that served it. -->
    <return-response>
      <set-status code="@(((IResponse)context.Variables["adfResponse"]).StatusCode)" reason="@(((IResponse)context.Variables["adfResponse"]).StatusReason)" />
      <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
      <set-header name="X-Served-Region" exists-action="override"><value>@((string)context.Variables["servedRegion"])</value></set-header>
      <set-body>@(((IResponse)context.Variables["adfResponse"]).Body.As<string>())</set-body>
    </return-response>
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
